{
  "name": "hexfall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @hexfall/web dev",
    "build": "pnpm --filter @hexfall/web build",
    "preview": "pnpm --filter @hexfall/web preview",
    "test": "pnpm -r --if-present test",
    "coverage": "pnpm --filter @hexfall/engine coverage",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck",
    "e2e": "pnpm --filter @hexfall/web e2e",
    "format": "prettier --write .",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.12.2"
  }
}
