{
  "name": "hexfall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter @hexfall/web --filter @hexfall/server dev",
    "build": "pnpm --filter @hexfall/web build",
    "preview": "pnpm --filter @hexfall/web preview",
    "play": "pnpm build && pnpm server",
    "test": "pnpm -r --if-present test",
    "coverage": "pnpm --filter @hexfall/engine coverage",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck",
    "e2e": "pnpm --filter @hexfall/web e2e",
    "bench": "pnpm --filter @hexfall/web bench",
    "format": "prettier --write .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev:web": "pnpm --filter @hexfall/web dev",
    "server": "pnpm --filter @hexfall/server start",
    "start": "pnpm build && pnpm server",
    "golden": "pnpm --filter @hexfall/server exec tsx ../../native/golden/export.ts",
    "native:test": "powershell -NoProfile -ExecutionPolicy Bypass -File native/build.ps1 -Test",
    "catnight:test": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/catnight/test.ps1",
    "catnight:test-heroes": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/catnight/test-heroes.ps1",
    "catnight:test-package": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/catnight/test-package.ps1",
    "catnight:package": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/catnight/package-game.ps1",
    "catnight:heroes": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/catnight/import-heroes.ps1",
    "catnight:import": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/catnight/import.ps1",
    "unreal:export": "pnpm --filter @hexfall/server exec tsx ../../apps/web/scripts/unreal/export-world.ts",
    "unreal:web": "pnpm build && node apps/unreal/stage-web-game.mjs",
    "unreal:open": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/unreal/open-island.ps1",
    "unreal:test": "pnpm unreal:export && pnpm --filter @hexfall/server exec tsx --test ../../apps/web/scripts/unreal/glb.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.12.2"
  }
}
